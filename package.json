{
  "name": "weathermapz-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint src vite.config.js --max-warnings=0",
    "format": "prettier --write \"src/**/*.{js,jsx}\" \"*.{js,cjs,mjs,json,md}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\" \"*.{js,cjs,mjs,json,md}\" \".github/**/*.yml\"",
    "preview": "vite preview",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "ci": "npm run lint && npm run format:check && npm test -- --runInBand && npm run build"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.25.0",
    "@babel/preset-react": "^7.24.7",
    "@stylistic/eslint-plugin": "5.10.0",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^5.0.0",
    "babel-jest": "^29.7.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-stylistic-airbnb": "3.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "3.9.9",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.0"
  }
}
